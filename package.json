{
  "name": "frayz",
  "version": "0.0.1",
  "private": true,
  "description": "Jogo original de navegador: criaturas colecionáveis com partes, batalha 3 contra 3 com cartas, cruzamento e mercado",
  "scripts": {
    "test": "node tools/verde.mjs rodar servidor \"node --test 'tests/servidor/*.test.js'\"",
    "test:travas": "node tools/verde.mjs rodar travas \"node --test tests/travas.test.mjs\"",
    "simular": "node tools/simular-batalha.mjs",
    "simular:economia": "node tools/simular-economia.mjs",
    "dev": "node server/dev.mjs",
    "servidor": "node server/index.mjs",
    "e2e:arte": "node tools/trava-robos.mjs rodar \"node tests/tela/arte.e2e.mjs\"",
    "e2e:pecas": "node tools/trava-robos.mjs rodar \"node tests/tela/pecas.e2e.mjs\"",
    "e2e:pagina": "node tools/trava-robos.mjs rodar \"node tests/tela/pagina.e2e.mjs\"",
    "e2e:servidor": "node tools/trava-robos.mjs rodar \"node tests/tela/servidor.e2e.mjs\"",
    "e2e:piloto": "node tools/trava-robos.mjs rodar \"timeout 700 node tests/tela/piloto.e2e.mjs\"",
    "e2e": "node tools/trava-robos.mjs rodar \"node tests/tela/prototipo.e2e.mjs\" && node tools/trava-robos.mjs rodar \"node tests/tela/tela2.e2e.mjs\" && node tools/trava-robos.mjs rodar \"node tests/tela/som.e2e.mjs\""
  },
  "engines": {
    "node": ">=22.13"
  }
}
